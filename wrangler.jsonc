{
  "name": "rally-scheduler-api",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-10",
  "workers_dev": true,
  "kv_namespaces": [
    {
      "binding": "POLLS",
      "id": "00000000000000000000000000000000"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "POLL_COORDINATORS",
        "class_name": "PollCoordinator"
      },
      {
        "name": "ACCOUNT_COORDINATORS",
        "class_name": "AccountCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PollCoordinator"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["AccountCoordinator"]
    }
  ],
  "vars": {
    "MAX_POLL_DATES": "unlimited",
    "MAX_POLL_RESPONSES": "100",
    "ALLOWED_ORIGINS": "*"
  },
  "observability": {
    "enabled": true
  }
}