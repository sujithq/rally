{
  "name": "rally-scheduler",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "config:check": "node scripts/validate-config.mjs",
    "dev": "npm run config:check && concurrently \"vite\" \"node --watch --env-file-if-exists=.env server/index.js\"",
    "dev:client": "vite",
    "dev:server": "node --watch --env-file-if-exists=.env server/index.js",
    "build": "npm run config:check && tsc -b && vite build",
    "build:pages": "npm run config:check && tsc -b && vite build --mode pages",
    "check:worker": "node --check worker/index.js",
    "worker:config": "node scripts/create-wrangler-config.mjs",
    "worker:identity": "node scripts/worker-identity.mjs",
    "config:verify-deployed": "node scripts/verify-deployed-config.mjs",
    "test": "npm run config:check && npm run test:config && npm run test:worker && npm run test:server",
    "test:config": "node --test scripts/*.test.mjs",
    "test:server": "node --test server/index.test.js server/config.test.js",
    "test:worker": "node --test worker/index.test.js",
    "start": "npm run config:check && node --env-file-if-exists=.env server/index.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "ajv": "^8.20.0",
    "express": "^5.1.0",
    "lucide-react": "^0.539.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "^8.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "concurrently": "^9.2.0",
    "typescript": "^5.9.2"
  }
}
