{
  "name": "rally-scheduler",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"node --watch --env-file-if-exists=.env server/index.js\"",
    "dev:client": "vite",
    "dev:server": "node --watch --env-file-if-exists=.env server/index.js",
    "build": "tsc -b && vite build",
    "check:worker": "node --check worker/index.js",
    "test": "npm run test:worker && npm run test:server",
    "test:server": "node --test server/index.test.js",
    "test:worker": "node --test worker/index.test.js",
    "start": "node --env-file-if-exists=.env server/index.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "express": "^5.1.0",
    "lucide-react": "^0.539.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "^7.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "concurrently": "^9.2.0",
    "typescript": "^7.0.2"
  }
}
