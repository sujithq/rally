{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rally.local/rally.config.schema.json",
  "title": "Rally instance configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["site", "deployment", "accounts", "polls"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "title", "description", "themeColor"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 40 },
        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string", "minLength": 1, "maxLength": 160 },
        "themeColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workerName", "apiBaseUrl", "allowedOrigins"],
      "properties": {
        "workerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
        },
        "apiBaseUrl": { "type": "string", "format": "uri" },
        "allowedOrigins": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "format": "uri" }
        }
      }
    },
    "accounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "registration"],
      "properties": {
        "mode": { "enum": ["disabled", "optional", "required"] },
        "registration": { "enum": ["open", "closed"] }
      },
      "allOf": [
        {
          "if": {
            "properties": { "mode": { "const": "disabled" } },
            "required": ["mode"]
          },
          "then": {
            "properties": { "registration": { "const": "closed" } }
          }
        }
      ]
    },
    "polls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxDates", "maxResponses"],
      "properties": {
        "maxDates": {
          "oneOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 1 }
          ]
        },
        "maxResponses": { "type": "integer", "minimum": 1 }
      }
    }
  }
}